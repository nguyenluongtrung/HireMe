generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator json {
  provider = "prisma-json-types-generator"
}

model User {
  id          Int     @id @default(autoincrement())
  email       String  @unique
  name        String  @db.VarChar(500)
  password    String  @db.VarChar(500)
  phoneNumber String? @db.VarChar(50)
  avatarUrl   String? @db.VarChar(1000)

  status             UserStatus          @default(INACTIVE)
  roleId             Int
  role               Role                @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refreshTokens      RefreshToken[]
  createdPermissions Permission[]        @relation("PermissionCreatedBy")
  updatedPermissions Permission[]        @relation("PermissionUpdatedBy")
  deletedPermissions Permission[]        @relation("PermissionDeletedBy")
  createdRoles       Role[]              @relation("RoleCreatedBy")
  updatedRoles       Role[]              @relation("RoleUpdatedBy")
  deletedRoles       Role[]              @relation("RoleDeletedBy")
  applications       Application[]
  knowledgeItems     KnowledgeItem[]
  knowledgeResources KnowledgeResource[]
  createdById        Int?
  createdBy          User?               @relation("CreatorUsers", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdUsers       User[]              @relation("CreatorUsers")

  updatedById  Int?
  updatedBy    User?  @relation("UpdatorUsers", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedUsers User[] @relation("UpdatorUsers")
  deletedById  Int?
  deletedBy    User?  @relation("DeletorUsers", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedUsers User[] @relation("DeletorUsers")

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

model RefreshToken {
  token     String   @unique @db.VarChar(1000)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Permission {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(500)
  description String     @default("")
  path        String     @db.VarChar(1000)
  method      HTTPMethod
  module      String     @default("") @db.VarChar(500)
  roles       Role[]

  createdById Int?
  createdBy   User? @relation("PermissionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("PermissionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("PermissionDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(500)
  description String       @default("")
  isActive    Boolean      @default(true)
  permissions Permission[]
  users       User[]

  createdById Int?
  createdBy   User? @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("RoleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("RoleDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

model Application {
  id          Int               @id @default(autoincrement())
  companyName String            @db.VarChar(500)
  position    String            @default("")
  notes       String            @default("")
  userId      Int
  user        User              @relation(fields: [userId], references: [id])
  status      ApplicationStatus @default(PENDING)

  dateApplied DateTime @default(now())

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

// Knowledge Hub Models
model KnowledgeResource {
  id    Int               @id @default(autoincrement())
  title String            @db.VarChar(500)
  slug  String            @db.VarChar(600)
  type  KnowledgeItemType @default(FILE)

  // User ownership
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One resource has many items
  items KnowledgeItem[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([deletedAt])
  @@index([type])
}

model KnowledgeItem {
  id    Int               @id @default(autoincrement())
  title String            @db.VarChar(500)
  slug  String            @db.VarChar(600)
  type  KnowledgeItemType @default(FILE)

  // Content for files/notes
  content String? @db.Text

  // ---------- Resource relation ----------
  knowledgeResourceId Int
  knowledgeResource   KnowledgeResource @relation(fields: [knowledgeResourceId], references: [id], onDelete: Cascade)

  // User ownership
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Tags
  tags KnowledgeTag[]

  // Metadata
  isFavorite Boolean @default(false)
  isArchived Boolean @default(false)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([knowledgeResourceId])
  @@index([deletedAt])
  @@index([type])
}

model KnowledgeTag {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)

  // Belongs to one KnowledgeItem
  knowledgeItemId Int
  knowledgeItem   KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  createdAt DateTime @default(now())

  @@index([knowledgeItemId])
}

enum VerificationCodeType {
  REGISTER
  FORGOT_PASSWORD
  LOGIN
  DISABLE_2FA
}

enum ApplicationStatus {
  PENDING
  APPLIED
  INTERVIEWED
  ACCEPTED
  REJECTED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum HTTPMethod {
  GET
  POST
  PUT
  DELETE
  PATCH
  OPTIONS
  HEAD
}

enum MediaType {
  IMAGE
  VIDEO
}

enum KnowledgeItemType {
  FOLDER
  FILE
}
